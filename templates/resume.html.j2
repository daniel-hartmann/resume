<!DOCTYPE HTML>
<html>
    <head>
        <meta content="text/html; charset=UTF-8" http-equiv="Content-Type"/>
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{{ name }} - Resume</title>
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
        <link type="text/css" rel="stylesheet" href="resume.css">
    </head>
    <body>
        <header>
            <div id="header-content">
                <div class="header-left">
                    <h1>{{ name }}</h1>
                    <h2>{{ title }}</h2>
                    <p>{{ summary.strip() }}</p>
                </div>
                <div class="header-right">
                    <ul class="contact-list">
                        {% if full_contact %}
                        <li>
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 5.5h18v13H3z"/><path d="m3 6 9 7 9-7"/></svg>
                            <a href="mailto:{{ contact.email }}">{{ contact.email }}</a>
                        </li>
                        <li>
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13 1 .36 1.98.68 2.92a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.16-1.16a2 2 0 0 1 2.11-.45c.94.32 1.92.55 2.92.68A2 2 0 0 1 22 16.92z"/></svg>
                            <span>{{ contact.phone }}</span>
                        </li>
                        {% endif %}
                        <li>
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 6-9 12-9 12s-9-6-9-12a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                            <span>{{ contact.location }}</span>
                        </li>
                        <li>
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
                            <a href="{{ contact.linkedin.url }}" target="_blank">{{ contact.linkedin.label }}</a>
                        </li>
                        <li class="screen-only pdf-link">
                            <a href="resume.pdf"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="M7 10l5 5 5-5"/><path d="M12 15V3"/></svg>Download PDF</a>
                        </li>
                    </ul>
                </div>
            </div>
        </header>

        <div class="container">
            <div class="left">

                <section>
                    <div class="title">Skills</div>
                    <article>
                        <div class="tags">
                            {% for skill in skills %}
                            <span>{{ skill }}</span>
                            {% endfor %}
                        </div>
                    </article>
                    <div class="title">Education</div>
                    {% for edu in education %}
                    <article>
                        <h2>{{ edu.degree }}</h2>
                        <h3>{{ edu.institution }}<br/>{{ edu.location }}<br/>{{ edu.period }}</h3>
                        {% if edu.description %}
                        <p>{{ edu.description.strip() }}</p>
                        {% endif %}
                        {% if edu.bullets %}
                        <ul>
                            {% for bullet in edu.bullets %}
                            <li>{{ bullet }}</li>
                            {% endfor %}
                        </ul>
                        {% endif %}
                    </article>
                    {% endfor %}

                    <article>
                        <h2>Languages Proficiency</h2>
                        <ul>
                            {% for lang in languages %}
                            <li>{{ lang.language }}: {{ lang.level }}</li>
                            {% endfor %}
                        </ul>
                    </article>
                </section>

                <div class="title">Links</div>

                <section class="links">
                    <article>
                        <ul>
                            {% for link in links %}
                            <li><a href="{{ link.url }}" target="_blank">{{ link.label }}</a></li>
                            {% endfor %}
                        </ul>
                    </article>
                </section>

                <div class="title">Interests</div>
                <section>
                    <article>
                        <ul>
                            {% for interest in interests %}
                            <li>{{ interest }}</li>
                            {% endfor %}
                        </ul>
                    </article>
                </section>
            </div>

            <div class="right">
                <section>
                    <div class="title">Work Experience</div>

                    {% for job in experience %}
                    <article>
                        <h2>{{ job.role }}</h2>
                        <span class="work-period">{{ job.period }}</span>
                        <h3>{{ job.company }}{% if job.location %} · {{ job.location }}{% endif %}</h3>
                        {% if job.description %}
                        <p>{{ job.description.strip() }}</p>
                        {% endif %}
                        {% if job.bullets %}
                        <ul>
                            {% for bullet in job.bullets %}
                            <li>{{ bullet }}</li>
                            {% endfor %}
                        </ul>
                        {% endif %}
                        {% if job.tags %}
                        <div class="tags work-tags">
                            {% for tag in job.tags %}
                            <span>{{ tag }}</span>
                            {% endfor %}
                        </div>
                        {% endif %}
                    </article>
                    {% endfor %}
                </section>

            </div>
        </div>
        <div class="footer">
            <p>{{ footer }}</p>
        </div>
    </body>
</html>
